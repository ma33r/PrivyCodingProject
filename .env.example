# Copy to .env and adjust. Every variable is optional; the values shown are the defaults.

# Server
MET_HOST=127.0.0.1
MET_PORT=8000
MET_LOG_LEVEL=INFO

# API behaviour
MET_DEFAULT_QUERY=bread
MET_DEFAULT_LIMIT=5
MET_MAX_LIMIT=20
MET_CACHE_TTL_S=3600
MET_WARM_CACHE=true

# Politeness towards the Met API
MET_MAX_CONCURRENCY=6
MET_MAX_RETRIES=3
MET_BACKOFF_BASE_S=0.5
MET_REQUEST_TIMEOUT_S=10
# Waits (seconds) before each retry after a 403 from the Met's bot protection; JSON list.
MET_THROTTLE_BACKOFF_S=[3, 7, 15]
MET_THROTTLE_COOLDOWN_S=30
